{
  "name": "event-storming-tool",
  "version": "0.2.2",
  "description": "E2 collaborative domain modeling board — viewer and editor for .e2.json (Event Storming, DDD, BDD, …)",
  "private": false,
  "author": "Andreas Bergmann",
  "license": "MIT",
  "homepage": "https://abx-git.github.io/E2/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abx-git/E2.git"
  },
  "bugs": {
    "url": "https://github.com/abx-git/E2/issues"
  },
  "keywords": [
    "e2",
    "event-storming",
    "ddd",
    "domain-driven-design",
    "viewer",
    "board",
    "workshop"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "e2-viewer": "./scripts/e2-viewer.mjs",
    "e2": "./scripts/e2-viewer.mjs",
    "e2-render": "./scripts/e2-render.mjs"
  },
  "exports": {
    "./embed": "./src/embed/index.ts",
    "./embed/markdown-it": "./src/embed/markdown-it-e2.mjs"
  },
  "files": [
    "scripts/e2-viewer.mjs",
    "scripts/e2-render.mjs",
    "scripts/e2-render.ts",
    "src/embed",
    "src",
    "public",
    "next.config.ts",
    "next-env.d.ts",
    "postcss.config.mjs",
    "tailwind.config.ts",
    "tsconfig.json",
    "middleware.ts"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "bash scripts/build-static.sh",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:run": "vitest run",
    "viewer": "node scripts/e2-viewer.mjs",
    "render": "tsx scripts/e2-render.ts",
    "prepack": "npm run test:run -- src/lib/board-remote-url.test.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@mdxeditor/editor": "^4.2.0",
    "@serwist/next": "^9.5.11",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "lib0": "^0.2.117",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "postcss": "^8.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "serwist": "^9.5.11",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "playwright": "^1.55.0"
  }
}
